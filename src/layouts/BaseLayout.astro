---
import '../styles/global.css';
import { company, services, products, trading } from '../data/site';
interface Props {
  title?: string;
  description?: string;
  country?: 'kw'|'ae'|'in';
  noindex?: boolean;
  ogImage?: string;
  hreflangGroup?: boolean;
  structuredData?: Record<string, any>[];
}
const {
  title='Technology & Trading Solutions',
  description='EFU delivers networking, Wi-Fi, structured cabling, CCTV, PBX, IT infrastructure and international trading solutions across Kuwait, UAE and India.',
  country='kw',
  noindex=false,
  ogImage='/images/og-cover.jpg',
  hreflangGroup=false,
  structuredData=[]
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const contact = company.countries[country];
const ogLocale = { kw:'en_KW', ae:'en_AE', in:'en_IN' }[country];
const hreflangPaths: [string, string][] = [['en-KW','/'],['en-AE','/locations/ae'],['en-IN','/locations/in'],['x-default','/']];
const schema = {
  '@context':'https://schema.org',
  '@type':'Organization',
  '@id': new URL('/#organization', Astro.site).toString(),
  name: company.name,
  url: Astro.site?.toString(),
  logo: new URL('/efu-logo.jpg', Astro.site).toString(),
  email: company.email,
  telephone: contact.tel,
  areaServed: ['Kuwait','United Arab Emirates','India'],
  contactPoint: Object.entries(company.countries).map(([key,c])=>({
    '@type':'ContactPoint',
    telephone: c.tel,
    contactType: 'sales',
    areaServed: key.toUpperCase(),
    availableLanguage: ['English']
  }))
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex,nofollow" />}
  <link rel="canonical" href={canonical} />
  {hreflangGroup && hreflangPaths.map(([lang,path])=><link rel="alternate" hreflang={lang} href={new URL(path, Astro.site)} />)}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="icon" type="image/jpeg" href="/efu-logo.jpg" />
  <link rel="apple-touch-icon" href="/efu-logo.jpg" />
  <meta name="theme-color" content="#0b1f33" />
  <meta property="og:title" content={`${title} | ${company.name}`} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={company.name} />
  <meta property="og:locale" content={ogLocale} />
  <meta property="og:image" content={new URL(ogImage, Astro.site)} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={`${title} | ${company.name}`} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />
  <title>{title} | {company.name}</title>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  {structuredData.map(item => <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />)}
  <slot name="head" />
</head>
<body data-country={country}>
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="utility"><div class="container utility-inner"><span>Operating across Kuwait, UAE & India</span><div><a href={`tel:${contact.tel}`}>{contact.phone}</a><a href={`mailto:${company.email}`}>{company.email}</a></div></div></div>
  <header class="header" id="header">
    <div class="container nav-wrap">
      <a href="/" class="brand" aria-label="EFU Goods Traders home"><img src="/efu-logo.jpg" alt="EFU logo" width="58" height="58"/><span>EFU <small>Goods Traders</small></span></a>
      <button class="menu-toggle" aria-expanded="false" aria-controls="main-nav"><span></span><span></span><span></span><b class="sr-only">Menu</b></button>
      <nav id="main-nav" aria-label="Main navigation">
        <a href="/">Home</a>
        <div class="nav-item"><button class="nav-trigger" id="solutions-trigger" type="button" aria-expanded="false" aria-haspopup="true" aria-controls="solutions-menu">Solutions</button><div class="mega nav-panel" id="solutions-menu" aria-labelledby="solutions-trigger"><div><strong>Technology solutions</strong>{services.map(s=><a href={`/solutions/${s.slug}`}><span>{s.title}</span><small>{s.short}</small></a>)}</div><aside><span class="panel-kicker">END-TO-END DELIVERY</span><b>One team from survey to support.</b><p>Plan, supply, install and maintain critical technology infrastructure.</p><a class="text-link" href="/solutions">View all solutions →</a></aside></div></div>
        <div class="nav-item"><button class="nav-trigger" id="products-trigger" type="button" aria-expanded="false" aria-haspopup="true" aria-controls="products-menu">Products</button><div class="dropdown nav-panel" id="products-menu" aria-labelledby="products-trigger">{products.map(p=><a href="/products">{p}<span>→</span></a>)}</div></div>
        <div class="nav-item"><button class="nav-trigger" id="trading-trigger" type="button" aria-expanded="false" aria-haspopup="true" aria-controls="trading-menu">Trading & Supply</button><div class="dropdown nav-panel" id="trading-menu" aria-labelledby="trading-trigger">{trading.map(t=><a href="/trading-supply">{t}<span>→</span></a>)}</div></div>
        <a href="/about">About</a><a href="/contact">Contact</a>
      </nav>
      <div class="nav-actions"><select aria-label="Select country" id="country-select"><option value="kw" selected={country==='kw'}>Kuwait</option><option value="ae" selected={country==='ae'}>UAE</option><option value="in" selected={country==='in'}>India</option></select><a class="btn btn-sm" href="/contact#quote">Request a Quote</a></div>
    </div>
  </header>
  <main id="main"><slot /></main>
  <footer><div class="container footer-grid"><div><a href="/" class="brand brand-light"><img src="/efu-logo.jpg" alt="" width="58" height="58"/><span>EFU <small>Goods Traders</small></span></a><p>Technology, infrastructure and international trading solutions across Kuwait, UAE and India.</p></div><div><h3>Solutions</h3>{services.slice(0,5).map(s=><a href={`/solutions/${s.slug}`}>{s.title}</a>)}</div><div><h3>Company</h3><a href="/about">About EFU</a><a href="/products">Products</a><a href="/trading-supply">Trading & Supply</a><a href="/contact">Contact</a></div><div><h3>Get in touch</h3><a href={`tel:${contact.tel}`}>{contact.phone}</a><a href={`mailto:${company.email}`}>{company.email}</a><p>{contact.name}</p></div></div><div class="container footer-bottom"><span>© {new Date().getFullYear()} EFU Goods Traders.</span><div><a href="/privacy">Privacy</a><a href="/sitemap-page">Sitemap</a></div></div></footer>
  {contact.whatsapp && <a class="whatsapp" href={`https://wa.me/${contact.whatsapp}?text=${encodeURIComponent('Hello EFU, I would like to discuss a technology project and request a quotation.')}`} target="_blank" rel="noreferrer" aria-label="Chat with EFU on WhatsApp">WA</a>}
  <script>
    const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
    const nav = document.querySelector<HTMLElement>('#main-nav');
    const desktopQuery = matchMedia('(min-width: 821px)');
    const navItems = [...document.querySelectorAll<HTMLElement>('.nav-item')];
    const closeTimers = new Map<HTMLElement, number>();
    const openModes = new WeakMap<HTMLElement, 'hover' | 'click'>();
    let lastActiveTrigger: HTMLButtonElement | null = null;

    const clearCloseTimer = (item: HTMLElement) => {
      const timer = closeTimers.get(item);
      if (timer !== undefined) window.clearTimeout(timer);
      closeTimers.delete(item);
    };
    const closeMenu = (item: HTMLElement) => {
      clearCloseTimer(item);
      item.classList.remove('active');
      openModes.delete(item);
      item.querySelector<HTMLButtonElement>('.nav-trigger')?.setAttribute('aria-expanded', 'false');
    };
    const closeMenus = (except?: HTMLElement) => navItems.forEach(item => {
      if (item !== except) closeMenu(item);
    });
    const clampPanel = (item: HTMLElement) => {
      if (!desktopQuery.matches) return;
      const panel = item.querySelector<HTMLElement>('.nav-panel');
      if (!panel) return;
      panel.style.setProperty('--panel-shift', '0px');
      const bounds = panel.getBoundingClientRect();
      const margin = 16;
      const shift = bounds.left < margin
        ? margin - bounds.left
        : bounds.right > innerWidth - margin
          ? innerWidth - margin - bounds.right
          : 0;
      panel.style.setProperty('--panel-shift', `${shift}px`);
    };
    const openMenu = (item: HTMLElement, mode: 'hover' | 'click') => {
      clearCloseTimer(item);
      closeMenus(item);
      const trigger = item.querySelector<HTMLButtonElement>('.nav-trigger');
      item.classList.add('active');
      openModes.set(item, mode);
      trigger?.setAttribute('aria-expanded', 'true');
      if (trigger) lastActiveTrigger = trigger;
      requestAnimationFrame(() => clampPanel(item));
    };
    const scheduleClose = (item: HTMLElement) => {
      clearCloseTimer(item);
      closeTimers.set(item, window.setTimeout(() => closeMenu(item), 200));
    };

    toggle?.addEventListener('click', event => {
      event.stopPropagation();
      const willOpen = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', String(willOpen));
      nav?.classList.toggle('open', willOpen);
      if (!willOpen) closeMenus();
    });

    navItems.forEach(item => {
      const trigger = item.querySelector<HTMLButtonElement>('.nav-trigger');
      const panel = item.querySelector<HTMLElement>('.nav-panel');
      trigger?.addEventListener('click', event => {
        event.stopPropagation();
        if (item.classList.contains('active') && openModes.get(item) !== 'hover') {
          closeMenu(item);
        } else {
          openMenu(item, 'click');
        }
      });
      item.addEventListener('mouseenter', () => {
        if (desktopQuery.matches) openMenu(item, 'hover');
      });
      item.addEventListener('mouseleave', () => {
        if (desktopQuery.matches) scheduleClose(item);
      });
      panel?.addEventListener('mouseenter', () => {
        if (desktopQuery.matches) clearCloseTimer(item);
      });
      panel?.addEventListener('mouseleave', () => {
        if (desktopQuery.matches) scheduleClose(item);
      });
      item.addEventListener('focusout', event => {
        if (desktopQuery.matches && !item.contains(event.relatedTarget as Node | null)) scheduleClose(item);
      });
    });

    document.addEventListener('click', event => {
      if (!nav?.contains(event.target as Node)) closeMenus();
    });
    document.addEventListener('keydown', event => {
      if (event.key !== 'Escape' || !navItems.some(item => item.classList.contains('active'))) return;
      event.preventDefault();
      closeMenus();
      lastActiveTrigger?.focus();
    });
    desktopQuery.addEventListener('change', event => {
      closeMenus();
      if (event.matches) {
        nav?.classList.remove('open');
        toggle?.setAttribute('aria-expanded', 'false');
      }
    });
    addEventListener('resize', () => {
      const activeItem = navItems.find(item => item.classList.contains('active'));
      if (activeItem) clampPanel(activeItem);
    }, { passive: true });
    document.querySelector('#country-select')?.addEventListener('change',(e)=>{const v=(e.target as HTMLSelectElement).value;localStorage.setItem('efu-country',v);location.href=v==='kw'?'/':`/locations/${v}`});
    addEventListener('scroll',()=>document.querySelector('#header')?.classList.toggle('scrolled',scrollY>30),{passive:true});
    const observer=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting)e.target.classList.add('visible')}),{threshold:.12});document.querySelectorAll('.reveal').forEach(el=>observer.observe(el));
  </script>
</body></html>
