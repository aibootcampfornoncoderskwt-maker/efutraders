---
import '../styles/global.css';
import { company, services, products, trading } from '../data/site';
interface Props {
  title?: string;
  description?: string;
  country?: 'kw'|'ae'|'in';
  noindex?: boolean;
  ogImage?: string;
  hreflangGroup?: boolean;
  structuredData?: Record<string, any>[];
}
const {
  title='Technology & Trading Solutions',
  description='EFU delivers networking, Wi-Fi, structured cabling, CCTV, PBX, IT infrastructure and international trading solutions across Kuwait, UAE and India.',
  country='kw',
  noindex=false,
  ogImage='/images/og-cover.jpg',
  hreflangGroup=false,
  structuredData=[]
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const contact = company.countries[country];
const ogLocale = { kw:'en_KW', ae:'en_AE', in:'en_IN' }[country];
const hreflangPaths: [string, string][] = [['en-KW','/'],['en-AE','/locations/ae'],['en-IN','/locations/in'],['x-default','/']];
const schema = {
  '@context':'https://schema.org',
  '@type':'Organization',
  '@id': new URL('/#organization', Astro.site).toString(),
  name: company.name,
  url: Astro.site?.toString(),
  logo: new URL('/efu-logo.jpg', Astro.site).toString(),
  email: company.email,
  telephone: contact.tel,
  areaServed: ['Kuwait','United Arab Emirates','India'],
  contactPoint: Object.entries(company.countries).map(([key,c])=>({
    '@type':'ContactPoint',
    telephone: c.tel,
    contactType: 'sales',
    areaServed: key.toUpperCase(),
    availableLanguage: ['English']
  }))
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <script is:inline>
    try {
      if (sessionStorage.getItem('efu-splash-seen') === '1') {
        document.documentElement.classList.add('no-splash');
      }
    } catch (e) {}
  </script>
  <style is:inline>
    .efu-splash{
      position:fixed;inset:0;width:100%;
      height:100vh;height:100dvh;min-height:100svh;
      z-index:99999;
      display:grid;place-items:center;
      background:#0b1f33;overflow:hidden;
      padding:max(24px,env(safe-area-inset-top)) max(20px,env(safe-area-inset-right)) max(24px,env(safe-area-inset-bottom)) max(20px,env(safe-area-inset-left));
      transition:opacity .4s ease;
    }
    .efu-splash::before{content:'';position:absolute;inset:-10%;background:radial-gradient(circle at 50% 42%,rgba(7,157,216,.18),transparent 62%);pointer-events:none}
    .efu-splash::after{content:'';position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px);background-size:34px 34px;pointer-events:none}
    .efu-splash-inner{position:relative;z-index:1;display:flex;flex-direction:column;align-items:center;text-align:center;transition:opacity .4s ease,transform .4s ease}
    .efu-splash-logo-frame{
      display:inline-flex;padding:clamp(16px,1.8vw,20px);border-radius:22px;
      background:rgba(255,255,255,.97);
      border:1px solid rgba(157,201,224,.35);
      box-shadow:0 16px 40px rgba(5,18,29,.4),0 0 46px rgba(7,157,216,.22);
      animation:efuSplashLogoIn .5s cubic-bezier(.16,1,.3,1) .08s both;
    }
    .efu-splash-logo{display:block;width:clamp(112px,12vw,172px);height:auto}
    .efu-splash-loader{
      width:clamp(34px,3vw,42px);height:clamp(34px,3vw,42px);
      position:relative;margin-top:28px;
      animation:efuSplashFadeIn .4s ease .3s both;
    }
    .efu-splash-loader-ring{position:absolute;inset:0;border-radius:50%;border:3px solid rgba(157,184,201,.28)}
    .efu-splash-loader-arc{position:absolute;inset:0;border-radius:50%;border:3px solid transparent;border-top-color:#079dd8;border-right-color:#079dd8;animation:efuSplashSpin .8s linear infinite;will-change:transform}
    .efu-splash-loader-dot{position:absolute;inset:0;animation:efuSplashSpin .8s linear infinite;will-change:transform}
    .efu-splash-loader-dot::after{content:'';position:absolute;top:-2px;left:50%;width:6px;height:6px;margin-left:-3px;border-radius:50%;background:#f59a23;box-shadow:0 0 8px rgba(245,154,35,.65)}
    .efu-splash-text{
      margin:18px 0 0;color:rgba(255,255,255,.8);
      font:500 clamp(.75rem,1vw,.875rem) Manrope,Arial,sans-serif;
      letter-spacing:.04em;
      animation:efuSplashFadeIn .4s ease .38s both;
    }
    @keyframes efuSplashLogoIn{from{opacity:0;transform:scale(.96)}to{opacity:1;transform:scale(1)}}
    @keyframes efuSplashFadeIn{from{opacity:0}to{opacity:1}}
    @keyframes efuSplashSpin{to{transform:rotate(360deg)}}
    html.efu-splash-exit .efu-splash{opacity:0;pointer-events:none}
    html.efu-splash-exit .efu-splash-inner{opacity:0;transform:translateY(-8px)}
    html.efu-splash-locked{overflow:hidden}
    html.no-splash .efu-splash{display:none}
    @media(prefers-reduced-motion:reduce){
      .efu-splash-loader-arc,.efu-splash-loader-dot{display:none}
      .efu-splash-loader-ring{border-color:rgba(7,157,216,.45)}
    }
  </style>
  <style>
    .whatsapp-float{
      position:fixed;right:24px;bottom:24px;z-index:60;
      display:inline-flex;align-items:center;
      height:56px;width:56px;
      border-radius:999px;background:#25D366;color:#fff;
      overflow:hidden;white-space:nowrap;text-decoration:none;
      box-shadow:0 8px 22px rgba(11,31,51,.22),0 2px 6px rgba(11,31,51,.14);
      opacity:0;transform:translateY(10px);
      animation:whatsappFloatIn .5s ease .3s forwards;
      transition:width .28s cubic-bezier(.2,.8,.2,1),box-shadow .25s ease,transform .2s ease;
    }
    .whatsapp-icon{flex:0 0 56px;width:56px;height:56px;display:grid;place-items:center}
    .whatsapp-icon svg{width:28px;height:28px;transition:transform .28s ease}
    .whatsapp-label{
      display:inline-block;max-width:0;overflow:hidden;padding-right:0;
      font:700 .86rem 'Plus Jakarta Sans',Manrope,sans-serif;letter-spacing:.01em;
      transition:max-width .28s cubic-bezier(.2,.8,.2,1),padding-right .28s ease;
    }
    .whatsapp-float:focus-visible{outline:2px solid #fff;outline-offset:3px;box-shadow:0 0 0 4px rgba(37,211,102,.45),0 12px 30px rgba(11,31,51,.28)}
    @media(hover:hover) and (pointer:fine){
      .whatsapp-float:hover,.whatsapp-float:focus-visible{
        width:205px;transform:translateY(-2px);
        box-shadow:0 14px 32px rgba(11,31,51,.3),0 3px 8px rgba(11,31,51,.16);
      }
      .whatsapp-float:hover .whatsapp-label,.whatsapp-float:focus-visible .whatsapp-label{max-width:132px;padding-right:14px}
      .whatsapp-float:hover .whatsapp-icon svg,.whatsapp-float:focus-visible .whatsapp-icon svg{transform:scale(1.04)}
    }
    @keyframes whatsappFloatIn{to{opacity:1;transform:none}}
    @media(max-width:820px){
      .whatsapp-float{
        right:max(16px,env(safe-area-inset-right));
        bottom:max(16px,env(safe-area-inset-bottom));
        height:52px;width:52px;
      }
      .whatsapp-icon{flex-basis:52px;width:52px;height:52px}
      .whatsapp-icon svg{width:26px;height:26px}
    }
    @media(prefers-reduced-motion:reduce){
      .whatsapp-float{animation:none;opacity:1;transform:none;transition:box-shadow .2s ease}
      .whatsapp-float:hover,.whatsapp-float:focus-visible{transform:none}
      .whatsapp-icon svg,.whatsapp-label{transition:none}
    }
  </style>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex,nofollow" />}
  <link rel="canonical" href={canonical} />
  {hreflangGroup && hreflangPaths.map(([lang,path])=><link rel="alternate" hreflang={lang} href={new URL(path, Astro.site)} />)}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="icon" type="image/jpeg" href="/efu-logo.jpg" />
  <link rel="apple-touch-icon" href="/efu-logo.jpg" />
  <meta name="theme-color" content="#0b1f33" />
  <meta property="og:title" content={`${title} | ${company.name}`} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={company.name} />
  <meta property="og:locale" content={ogLocale} />
  <meta property="og:image" content={new URL(ogImage, Astro.site)} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={`${title} | ${company.name}`} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />
  <title>{title} | {company.name}</title>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  {structuredData.map(item => <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />)}
  <slot name="head" />
</head>
<body data-country={country}>
  <div class="efu-splash" id="efu-splash" aria-hidden="true">
    <div class="efu-splash-inner">
      <div class="efu-splash-logo-frame">
        <img class="efu-splash-logo" src="/efu-logo.jpg" alt="" width="235" height="235" />
      </div>
      <div class="efu-splash-loader">
        <span class="efu-splash-loader-ring"></span>
        <span class="efu-splash-loader-arc"></span>
        <span class="efu-splash-loader-dot"></span>
      </div>
      <p class="efu-splash-text">Connecting your business</p>
    </div>
  </div>
  <noscript><style>#efu-splash{display:none!important}</style></noscript>
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="utility"><div class="container utility-inner"><span>Operating across Kuwait, UAE & India</span><div><a href={`tel:${contact.tel}`}>{contact.phone}</a><a href={`mailto:${company.email}`}>{company.email}</a></div></div></div>
  <header class="header" id="header">
    <div class="container nav-wrap">
      <a href="/" class="brand" aria-label="EFU Goods Traders home"><img src="/efu-logo.jpg" alt="EFU logo" width="58" height="58"/><span>EFU <small>Goods Traders</small></span></a>
      <button class="menu-toggle" aria-expanded="false" aria-controls="main-nav"><span></span><span></span><span></span><b class="sr-only">Menu</b></button>
      <nav id="main-nav" aria-label="Main navigation">
        <a href="/">Home</a>
        <div class="nav-item"><button class="nav-trigger" id="solutions-trigger" type="button" aria-expanded="false" aria-haspopup="true" aria-controls="solutions-menu">Solutions</button><div class="mega nav-panel" id="solutions-menu" aria-labelledby="solutions-trigger"><div><strong>Technology solutions</strong>{services.map(s=><a href={`/solutions/${s.slug}`}><span>{s.title}</span><small>{s.short}</small></a>)}</div><aside><span class="panel-kicker">END-TO-END DELIVERY</span><b>One team from survey to support.</b><p>Plan, supply, install and maintain critical technology infrastructure.</p><a class="mega-cta-link" href="/solutions"><span>View all solutions</span><span class="mega-cta-arrow" aria-hidden="true">→</span></a></aside></div></div>
        <div class="nav-item"><button class="nav-trigger" id="products-trigger" type="button" aria-expanded="false" aria-haspopup="true" aria-controls="products-menu">Products</button><div class="dropdown nav-panel" id="products-menu" aria-labelledby="products-trigger">{products.map(p=><a href="/products">{p}<span>→</span></a>)}</div></div>
        <div class="nav-item"><button class="nav-trigger" id="trading-trigger" type="button" aria-expanded="false" aria-haspopup="true" aria-controls="trading-menu">Trading & Supply</button><div class="dropdown nav-panel" id="trading-menu" aria-labelledby="trading-trigger">{trading.map(t=><a href="/trading-supply">{t}<span>→</span></a>)}</div></div>
        <a href="/about">About</a><a href="/contact">Contact</a>
      </nav>
      <div class="nav-actions"><select aria-label="Select country" id="country-select"><option value="kw" selected={country==='kw'}>Kuwait</option><option value="ae" selected={country==='ae'}>UAE</option><option value="in" selected={country==='in'}>India</option></select><a class="btn btn-sm" href="/contact#quote">Request a Quote</a></div>
    </div>
  </header>
  <main id="main"><slot /></main>
  <footer><div class="container footer-grid"><div><a href="/" class="brand brand-light"><img src="/efu-logo.jpg" alt="" width="58" height="58"/><span>EFU <small>Goods Traders</small></span></a><p>Technology, infrastructure and international trading solutions across Kuwait, UAE and India.</p></div><div><h3>Solutions</h3>{services.slice(0,5).map(s=><a href={`/solutions/${s.slug}`}>{s.title}</a>)}</div><div><h3>Company</h3><a href="/about">About EFU</a><a href="/products">Products</a><a href="/trading-supply">Trading & Supply</a><a href="/contact">Contact</a></div><div><h3>Get in touch</h3><a href={`tel:${contact.tel}`}>{contact.phone}</a><a href={`mailto:${company.email}`}>{company.email}</a><p>{contact.name}</p></div></div><div class="container footer-bottom"><span>© {new Date().getFullYear()} EFU Goods Traders.</span><div><a href="/privacy">Privacy</a><a href="/sitemap-page">Sitemap</a></div></div></footer>
  {contact.whatsapp && (
    <a
      class="whatsapp-float"
      id="whatsapp-float"
      href={`https://wa.me/${contact.whatsapp}?text=${encodeURIComponent('Hello EFU, I would like to discuss a technology or product requirement.')}`}
      data-wa-kw={company.countries.kw.whatsapp}
      data-wa-ae={company.countries.ae.whatsapp}
      data-wa-message={encodeURIComponent('Hello EFU, I would like to discuss a technology or product requirement.')}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Chat with EFU on WhatsApp"
    >
      <span class="whatsapp-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.08-.3-.15-1.26-.46-2.39-1.48-.88-.78-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51-.17-.01-.37-.01-.57-.01s-.52.07-.79.37c-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.06 2.87 1.21 3.07.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.42-.07-.12-.27-.2-.57-.35z"/>
          <path d="M12 2C6.48 2 2 6.48 2 12c0 1.88.51 3.74 1.48 5.36L2 22l4.73-1.44A9.96 9.96 0 0 0 12 22c5.52 0 10-4.48 10-10S17.52 2 12 2Zm0 18.18a8.15 8.15 0 0 1-4.15-1.13l-.3-.18-3.1.94.96-3.03-.2-.31A8.14 8.14 0 0 1 3.97 12c0-4.49 3.66-8.15 8.16-8.15 4.49 0 8.15 3.66 8.15 8.15 0 4.5-3.66 8.15-8.15 8.15Z"/>
        </svg>
      </span>
      <span class="whatsapp-label">Chat on WhatsApp</span>
    </a>
  )}
  <script>
    (() => {
      const splash = document.getElementById('efu-splash');
      if (!splash) return;
      const root = document.documentElement;
      const cleanup = () => {
        splash.remove();
        root.classList.remove('efu-splash-locked', 'efu-splash-exit');
      };
      let seen = false;
      try { seen = sessionStorage.getItem('efu-splash-seen') === '1'; } catch {}
      if (seen) { cleanup(); return; }
      root.classList.add('efu-splash-locked');
      const MIN_VISIBLE = 800;
      const SAFETY_MAX = 1800;
      const startedAt = Date.now();
      let exited = false;
      const exit = () => {
        if (exited) return;
        exited = true;
        try { sessionStorage.setItem('efu-splash-seen', '1'); } catch {}
        root.classList.add('efu-splash-exit');
        root.classList.remove('efu-splash-locked');
        splash.addEventListener('transitionend', cleanup, { once: true });
        window.setTimeout(cleanup, 500);
      };
      const ready = () => {
        const wait = Math.max(0, MIN_VISIBLE - (Date.now() - startedAt));
        window.setTimeout(exit, wait);
      };
      if (document.readyState === 'complete') ready();
      else window.addEventListener('load', ready, { once: true });
      window.setTimeout(exit, SAFETY_MAX);
      window.addEventListener('pageshow', event => {
        if (event.persisted) cleanup();
      });
    })();

    const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
    const nav = document.querySelector<HTMLElement>('#main-nav');
    const desktopQuery = matchMedia('(min-width: 821px)');
    const navItems = [...document.querySelectorAll<HTMLElement>('.nav-item')];
    const closeTimers = new Map<HTMLElement, number>();
    const openModes = new WeakMap<HTMLElement, 'hover' | 'click'>();
    let lastActiveTrigger: HTMLButtonElement | null = null;

    const clearCloseTimer = (item: HTMLElement) => {
      const timer = closeTimers.get(item);
      if (timer !== undefined) window.clearTimeout(timer);
      closeTimers.delete(item);
    };
    const closeMenu = (item: HTMLElement) => {
      clearCloseTimer(item);
      item.classList.remove('active');
      openModes.delete(item);
      item.querySelector<HTMLButtonElement>('.nav-trigger')?.setAttribute('aria-expanded', 'false');
    };
    const closeMenus = (except?: HTMLElement) => navItems.forEach(item => {
      if (item !== except) closeMenu(item);
    });
    const clampPanel = (item: HTMLElement) => {
      if (!desktopQuery.matches) return;
      const panel = item.querySelector<HTMLElement>('.nav-panel');
      if (!panel) return;
      panel.style.setProperty('--panel-shift', '0px');
      const bounds = panel.getBoundingClientRect();
      const margin = 16;
      const shift = bounds.left < margin
        ? margin - bounds.left
        : bounds.right > innerWidth - margin
          ? innerWidth - margin - bounds.right
          : 0;
      panel.style.setProperty('--panel-shift', `${shift}px`);
    };
    const openMenu = (item: HTMLElement, mode: 'hover' | 'click') => {
      clearCloseTimer(item);
      closeMenus(item);
      const trigger = item.querySelector<HTMLButtonElement>('.nav-trigger');
      item.classList.add('active');
      openModes.set(item, mode);
      trigger?.setAttribute('aria-expanded', 'true');
      if (trigger) lastActiveTrigger = trigger;
      requestAnimationFrame(() => clampPanel(item));
    };
    const scheduleClose = (item: HTMLElement) => {
      clearCloseTimer(item);
      closeTimers.set(item, window.setTimeout(() => closeMenu(item), 200));
    };

    toggle?.addEventListener('click', event => {
      event.stopPropagation();
      const willOpen = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', String(willOpen));
      nav?.classList.toggle('open', willOpen);
      if (!willOpen) closeMenus();
    });

    navItems.forEach(item => {
      const trigger = item.querySelector<HTMLButtonElement>('.nav-trigger');
      const panel = item.querySelector<HTMLElement>('.nav-panel');
      trigger?.addEventListener('click', event => {
        event.stopPropagation();
        if (item.classList.contains('active') && openModes.get(item) !== 'hover') {
          closeMenu(item);
        } else {
          openMenu(item, 'click');
        }
      });
      item.addEventListener('mouseenter', () => {
        if (desktopQuery.matches) openMenu(item, 'hover');
      });
      item.addEventListener('mouseleave', () => {
        if (desktopQuery.matches) scheduleClose(item);
      });
      panel?.addEventListener('mouseenter', () => {
        if (desktopQuery.matches) clearCloseTimer(item);
      });
      panel?.addEventListener('mouseleave', () => {
        if (desktopQuery.matches) scheduleClose(item);
      });
      item.addEventListener('focusout', event => {
        if (desktopQuery.matches && !item.contains(event.relatedTarget as Node | null)) scheduleClose(item);
      });
    });

    document.addEventListener('click', event => {
      if (!nav?.contains(event.target as Node)) closeMenus();
    });
    document.addEventListener('keydown', event => {
      if (event.key !== 'Escape' || !navItems.some(item => item.classList.contains('active'))) return;
      event.preventDefault();
      closeMenus();
      lastActiveTrigger?.focus();
    });
    desktopQuery.addEventListener('change', event => {
      closeMenus();
      if (event.matches) {
        nav?.classList.remove('open');
        toggle?.setAttribute('aria-expanded', 'false');
      }
    });
    addEventListener('resize', () => {
      const activeItem = navItems.find(item => item.classList.contains('active'));
      if (activeItem) clampPanel(activeItem);
    }, { passive: true });
    const waFloat = document.getElementById('whatsapp-float') as HTMLAnchorElement | null;
    const applyWaCountry = (key: string) => {
      if (!waFloat) return;
      const num = key === 'ae' ? waFloat.dataset.waAe : key === 'kw' ? waFloat.dataset.waKw : null;
      if (!num) return;
      waFloat.href = `https://wa.me/${num}?text=${waFloat.dataset.waMessage}`;
    };
    if (waFloat) {
      try {
        const storedCountry = localStorage.getItem('efu-country');
        if (storedCountry) applyWaCountry(storedCountry);
      } catch {}
    }
    document.querySelector('#country-select')?.addEventListener('change',(e)=>{const v=(e.target as HTMLSelectElement).value;localStorage.setItem('efu-country',v);applyWaCountry(v);location.href=v==='kw'?'/':`/locations/${v}`});
    addEventListener('scroll',()=>document.querySelector('#header')?.classList.toggle('scrolled',scrollY>30),{passive:true});
    const observer=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting)e.target.classList.add('visible')}),{threshold:.12});document.querySelectorAll('.reveal').forEach(el=>observer.observe(el));
  </script>
</body></html>
