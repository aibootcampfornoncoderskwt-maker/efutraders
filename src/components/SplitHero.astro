---
interface Props {
  eyebrow: string;
  heading: string;
  description: string;
  primaryCta: { label: string; href: string };
  secondaryCta: { label: string; href: string };
  points: string[];
  image: { src: string; srcSmall: string; width: number; height: number; alt: string };
}
const { eyebrow, heading, description, primaryCta, secondaryCta, points, image } = Astro.props;
---

<section class="split-hero">
  <div class="container split-hero-grid">
    <div class="split-hero-copy">
      <span class="eyebrow">{eyebrow}</span>
      <h1>{heading}</h1>
      <p>{description}</p>
      <div class="split-hero-actions">
        <a class="btn" href={primaryCta.href}>{primaryCta.label}</a>
        <a class="btn btn-outline-light" href={secondaryCta.href}>{secondaryCta.label}</a>
      </div>
      <ul class="split-hero-points">
        {points.map(point => <li>{point}</li>)}
      </ul>
    </div>
    <div class="split-hero-media">
      <div class="split-hero-frame">
        <img
          src={image.src}
          srcset={`${image.srcSmall} 600w, ${image.src} ${image.width}w`}
          sizes="(max-width: 820px) 100vw, 46vw"
          alt={image.alt}
          width={image.width}
          height={image.height}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .split-hero{position:relative;overflow:hidden;background:linear-gradient(180deg,#f6fafc 0%,#fff 62%);padding:clamp(2.5rem,5vw,4.5rem) 0 clamp(3rem,6vw,5rem)}
  .split-hero-grid{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);align-items:center;gap:clamp(2.5rem,5vw,5vw)}
  .split-hero-copy .eyebrow{display:block;color:var(--blue2);font:800 .72rem 'Plus Jakarta Sans',Manrope,sans-serif;letter-spacing:.15em;margin-bottom:1.1rem;opacity:0;transform:translateY(14px);animation:heroCopyRise .6s ease .05s both}
  .split-hero-copy h1{color:var(--navy);font-size:clamp(2.35rem,4.1vw,3.55rem);line-height:1.08;letter-spacing:-.03em;max-width:19ch;margin:0 0 1.15rem;opacity:0;transform:translateY(14px);animation:heroCopyRise .6s ease .12s both}
  .split-hero-copy p{color:var(--muted);font-size:clamp(1rem,1.1vw,1.12rem);line-height:1.7;max-width:52ch;margin:0 0 1.7rem;opacity:0;transform:translateY(14px);animation:heroCopyRise .6s ease .19s both}
  .split-hero-actions{display:flex;flex-wrap:wrap;gap:.8rem;opacity:0;transform:translateY(14px);animation:heroCopyRise .6s ease .26s both}
  .split-hero-actions .btn-outline-light{border-color:var(--line);color:var(--navy)}
  .split-hero-actions .btn-outline-light:hover{border-color:var(--blue);color:var(--blue2)}
  .split-hero-points{list-style:none;display:flex;flex-wrap:wrap;gap:.6rem 1.5rem;margin:1.6rem 0 0;padding:0;color:var(--ink);font-size:.82rem;font-weight:700;opacity:0;transform:translateY(14px);animation:heroCopyRise .6s ease .33s both}
  .split-hero-points li::before{content:'✓';color:var(--blue);margin-right:.45rem}
  .split-hero-media{position:relative}
  .split-hero-media::before{content:'';position:absolute;top:-40px;right:-30px;width:320px;height:320px;border-radius:50%;background:radial-gradient(circle,rgba(7,157,216,.32),transparent 70%);filter:blur(6px);z-index:0}
  .split-hero-media::after{content:'';position:absolute;inset:26px -22px -22px 34px;border-radius:20px;background-image:linear-gradient(rgba(11,31,51,.07) 1px,transparent 1px),linear-gradient(90deg,rgba(11,31,51,.07) 1px,transparent 1px);background-size:26px 26px;z-index:0}
  .split-hero-frame{position:relative;z-index:1;border-radius:22px;overflow:hidden;box-shadow:0 30px 70px rgba(11,31,51,.18);aspect-ratio:4/5}
  .split-hero-frame img{width:100%;height:100%;object-fit:cover;opacity:0;transform:scale(1.03);animation:heroImgReveal .9s cubic-bezier(.16,1,.3,1) .1s both}
  @keyframes heroCopyRise{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
  @keyframes heroImgReveal{from{opacity:0;transform:scale(1.03)}to{opacity:1;transform:scale(1)}}
  @media(max-width:980px){.split-hero-grid{grid-template-columns:1fr}.split-hero-media{order:-1;max-width:420px;margin:0 auto 1rem}}
  @media(max-width:560px){.split-hero-actions{display:grid}.split-hero-actions .btn{min-height:46px}}
  @media(prefers-reduced-motion:reduce){.split-hero-copy .eyebrow,.split-hero-copy h1,.split-hero-copy p,.split-hero-actions,.split-hero-points,.split-hero-frame img{animation:none;opacity:1;transform:none}}
</style>
