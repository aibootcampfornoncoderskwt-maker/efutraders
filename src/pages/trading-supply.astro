---
import BaseLayout from '../layouts/BaseLayout.astro'; import { trading } from '../data/site';
---
<BaseLayout title="International Trading & Supply" description="Construction materials, agricultural products, coconut products, spices, mechanical components and general sourcing across EFU markets."><section class="page-hero"><div class="container"><div class="breadcrumbs"><a href="/">Home</a> / Trading & Supply</div><span class="eyebrow">BEYOND TECHNOLOGY</span><h1>International trading and dependable sourcing.</h1><p>EFU supports commercial supply requirements across general goods, agricultural products, construction materials and mechanical components.</p></div></section><section class="section"><div class="container industry-grid">{trading.map((x,i)=><article><b>{String(i+1).padStart(2,'0')}</b><h2 style="font-size:1.35rem;margin-top:3rem">{x}</h2><p>Share specifications, quantity, destination and delivery requirements to discuss sourcing and availability.</p></article>)}</div></section></BaseLayout>
