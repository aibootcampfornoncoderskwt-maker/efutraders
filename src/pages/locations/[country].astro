---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { company, services, trading } from '../../data/site';
export function getStaticPaths(){return ['ae','in'].map(country=>({params:{country},props:{country}}))}
const {country}=Astro.props as {country:'ae'|'in'}; const c=company.countries[country]; const isIndia=country==='in';
---
<BaseLayout title={`${c.name} Operations`} description={`EFU technology, product and trading solutions in ${c.name}.`} country={country}><section class="page-hero"><div class="container"><div class="breadcrumbs"><a href="/">Home</a> / Locations / {c.name}</div><span class="eyebrow">EFU IN {c.name.toUpperCase()}</span><h1>{isIndia?'Trading, sourcing and technology products.':'Technology infrastructure and project supply.'}</h1><p>{isIndia?'Supporting international sourcing, agricultural supply, general trading and technology product requirements.':'Networking, structured cabling, CCTV, voice communication, security, installation and technology product supply.'}</p></div></section><section class="section"><div class="container"><header class="section-head"><div><span class="eyebrow">AVAILABLE CAPABILITIES</span><h2>Solutions for the {c.name} market.</h2></div><p>Service availability and project coverage are confirmed according to location and requirement.</p></header><div class="industry-grid">{(isIndia?trading:services.map(s=>s.title)).map((x,i)=><article><b>{String(i+1).padStart(2,'0')}</b><h2 style="font-size:1.25rem;margin-top:3rem">{x}</h2><p>Contact the local EFU team to discuss scope, products and availability.</p></article>)}</div></div></section><section class="cta"><div class="container cta-inner"><div><h2>Start a conversation with EFU {c.name}.</h2><p>Share your project or supply requirement for the appropriate next step.</p></div><div><a class="btn btn-white" href={`tel:${c.tel}`}>Call EFU {c.name}</a>{c.whatsapp && <a class="btn btn-outline-light" href={`https://wa.me/${c.whatsapp}`} target="_blank">WhatsApp EFU {c.name}</a>}<a class="btn btn-outline-light" href="/contact#quote">Request a Quote</a></div></div></section></BaseLayout>
