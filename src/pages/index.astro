---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroShowcase from '../components/HeroShowcase.astro';
import Icon from '../components/Icon.astro';
import { services, products, trading, industries, faq, company } from '../data/site';
const faqSchema = {
  '@context':'https://schema.org',
  '@type':'FAQPage',
  mainEntity: faq.map(([q,a])=>({ '@type':'Question', name:q, acceptedAnswer:{ '@type':'Answer', text:a } }))
};
const serviceMedia: Record<string,{src:string;alt:string}> = {
  'business-wifi': { src:'/images/solutions/business-wifi.webp', alt:'Technician installing a business wireless access point in a modern office' },
  'structured-cabling': { src:'/images/solutions/structured-cabling.webp', alt:'Organised network patch panels with labelled structured cabling' },
  'cctv-surveillance': { src:'/images/solutions/cctv-camera-commissioning.webp', alt:'Technician commissioning a commercial CCTV camera' },
  'voip-pbx': { src:'/images/solutions/voip-pbx-configuration.webp', alt:'Technician configuring business IP phones and VoIP equipment' },
  'network-security': { src:'/images/solutions/network-security-monitoring.webp', alt:'Network engineer monitoring and configuring secure network infrastructure' },
  'installation-support': { src:'/images/solutions/installation-support.webp', alt:'Field technician testing network infrastructure in a server room' }
};
const productIcons = ['switch','wifi','transceiver','cable','rack','camera','phone','meter','dish','monitor'];
---
<BaseLayout hreflangGroup structuredData={[faqSchema]}>
  <Fragment slot="head"><link rel="preload" as="image" href="/images/hero/technology-solutions.webp" imagesrcset="/images/hero/technology-solutions-960.webp 960w, /images/hero/technology-solutions.webp 1586w" imagesizes="100vw" fetchpriority="high" /></Fragment>
  <HeroShowcase />
  <section class="trust"><div class="container trust-grid"><span>Serving Kuwait, UAE & India</span><span>End-to-end project delivery</span><span>Multi-brand solutions</span><span>After-sales support</span></div></section>
  <section class="section" id="solutions">
    <div class="container">
      <header class="section-head reveal">
        <div><span class="eyebrow">WHAT WE DO</span><h2>Technology solutions built around your site.</h2></div>
        <p>Practical infrastructure for commercial and residential environments—from the first assessment to final handover.</p>
      </header>
      <div class="service-grid">
        {services.map((service,index) => {
          const media = serviceMedia[service.slug];
          return (
            <a class="service-card home-service-card reveal" href={`/solutions/${service.slug}`}>
              <div class="home-service-media">
                <img
                  src={media.src}
                  alt={media.alt}
                  width="900"
                  height="563"
                  sizes="(max-width: 560px) calc(100vw - 32px), (max-width: 1050px) calc((100vw - 64px) / 2), 410px"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="home-service-body">
                <div class="icon" aria-hidden="true"><Icon name={service.icon}/></div>
                <span class="card-no" aria-hidden="true">{String(index+1).padStart(2,'0')}</span>
                <h3>{service.title}</h3>
                <p>{service.short}</p>
                <span class="home-service-action">Explore solution <span aria-hidden="true">→</span></span>
              </div>
            </a>
          );
        })}
      </div>
      <div class="all-solutions-link reveal"><a href="/solutions">View all technology solutions <span aria-hidden="true">→</span></a></div>
    </div>
  </section>
  <section class="section capabilities"><div class="container"><header class="section-head light reveal"><div><span class="eyebrow">FIELD CAPABILITIES</span><h2>Professional infrastructure. Installed with precision.</h2></div><p>Representative installation capabilities. Replace with verified EFU project photography as client assets become available.</p></header><div class="capability-gallery"><article class="cap-main reveal"><img src="/images/structured-cabling.webp" alt="Professionally organised structured cabling and network rack" loading="lazy" width="1200" height="900"/><div><span>01 / STRUCTURED CABLING</span><h3>Organised, labelled and ready to scale.</h3><a href="/solutions/structured-cabling">View capability →</a></div></article><article class="cap-side reveal"><img src="/images/office-installation.webp" alt="Technician installing office Wi-Fi and CCTV infrastructure" loading="lazy" width="1200" height="900"/><div><span>02 / SECURITY & WI-FI</span><h3>Coverage designed around the site.</h3><a href="/solutions/cctv-surveillance">View capability →</a></div></article></div></div></section>
  <section class="section process"><div class="container"><header class="section-head light reveal"><div><span class="eyebrow">HOW WE WORK</span><h2>One partner from survey to support.</h2></div><p>A clear delivery process keeps technical work organised, accountable and aligned with your operational needs.</p></header><div class="steps process-line">{[['01','Survey','We review the site, coverage, infrastructure and operational requirements.'],['02','Design','We plan equipment, coverage, cable routes and a suitable technical solution.'],['03','Supply & install','We coordinate products, installation, configuration, testing and handover.'],['04','Support','We assist with maintenance, troubleshooting, expansion and upgrades.']].map(x=><article class="reveal"><b>{x[0]}</b><h3>{x[1]}</h3><p>{x[2]}</p></article>)}</div></div></section>
  <section class="section"><div class="container feature-stack"><article class="feature reveal"><div class="feature-art image-art"><img src="/images/office-installation.webp" alt="Professional office Wi-Fi and security installation" loading="lazy" width="1200" height="900"/><span class="image-label">WI-FI • CCTV • SUPPORT</span></div><div><span class="eyebrow">BUSINESS WI-FI</span><h2>Stronger Wi-Fi without dead zones.</h2><p>Reliable Wi-Fi depends on layout, access-point placement, interference and capacity—not simply adding another router. EFU plans coverage around how the property is actually used.</p><a class="text-link" href="/solutions/business-wifi">Explore Business Wi-Fi →</a></div></article><article class="feature reverse reveal"><div class="feature-art image-art"><img src="/images/structured-cabling.webp" alt="Clean fibre and copper structured cabling installation" loading="lazy" width="1200" height="900"/><span class="image-label">CAT6A • FIBRE • NETWORK RACKS</span></div><div><span class="eyebrow">STRUCTURED INFRASTRUCTURE</span><h2>Built cleanly. Ready to grow.</h2><p>Well-planned copper and fibre infrastructure improves reliability, simplifies maintenance and prepares your network for future expansion.</p><a class="text-link" href="/solutions/structured-cabling">Explore Structured Cabling →</a></div></article></div></section>
  <section class="section products">
    <div class="container">
      <div class="products-header">
        <div class="products-header-copy reveal">
          <span class="eyebrow">PRODUCT SUPPLY</span>
          <h2>Technology products for complete project delivery.</h2>
          <p>Source network, communication and security equipment individually or as part of a complete supply and installation project.</p>
          <div class="products-header-actions">
            <a class="btn" href="/contact#quote">Send your product list</a>
            <a class="text-link" href="/products">View all products <span aria-hidden="true">→</span></a>
          </div>
        </div>
        <div class="products-header-media reveal">
          <div class="products-media-frame">
            <img
              src="/images/hero/products-equipment.webp"
              srcset="/images/hero/products-equipment-960.webp 960w, /images/hero/products-equipment.webp 1536w"
              sizes="(max-width: 900px) 100vw, 46vw"
              alt="Arranged collection of enterprise network switches, wireless access points, SFP transceivers, fibre cabling, CCTV cameras, IP business phones and a network testing tool"
              width="1536"
              height="1024"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </div>
      <div class="home-product-list">
        {products.map((p,i) => (
          <a class="reveal" href="/products" aria-label={`View ${p} products`}>
            <b aria-hidden="true">{String(i+1).padStart(2,'0')}</b>
            <span class="home-product-icon" aria-hidden="true"><Icon name={productIcons[i]}/></span>
            <span class="home-product-label">{p}</span>
            <i aria-hidden="true">→</i>
          </a>
        ))}
      </div>
    </div>
  </section>
  <section class="section industries"><div class="container"><span class="eyebrow">ENVIRONMENTS WE SUPPORT</span><h2>Solutions for the way your site works.</h2><div class="industry-grid">{industries.map((x,i)=><article class="reveal"><b>{String(i+1).padStart(2,'0')}</b><h3>{x}</h3><p>Planned infrastructure, installation and technical support aligned with the needs of this environment.</p></article>)}</div></div></section>
  <section class="section trading"><div class="container trading-grid"><div class="trade-mark reveal"><span>EFU</span><b>Global sourcing<br/>Regional delivery</b></div><div class="reveal"><span class="eyebrow">BEYOND TECHNOLOGY</span><h2>International trading and supply.</h2><p>EFU also supports commercial sourcing and supply requirements across construction materials, mechanical components, agricultural products and general goods.</p><div class="trade-list">{trading.map(x=><span>{x}</span>)}</div><a class="btn" href="/trading-supply">Explore Trading & Supply</a></div></div></section>
  <section class="section locations"><div class="container"><header class="section-head reveal"><div><span class="eyebrow">OUR LOCATIONS</span><h2>Regional reach. Local project support.</h2></div><p>Choose your market to view the most relevant solutions and contact information.</p></header><div class="location-grid">{Object.entries(company.countries).map(([key,c])=><a class="location-card reveal" href={key==='kw'?'/':`/locations/${key}`}><span>{key.toUpperCase()}</span><h3>{c.name}</h3><p>{key==='in'?'Trading, sourcing and technology products':'Networking, security, communication and project supply'}</p><b>View location →</b></a>)}</div></div></section>
  <section class="section faq"><div class="container faq-grid"><div class="reveal"><span class="eyebrow">QUESTIONS, ANSWERED</span><h2>What to know before your project starts.</h2><p>Need advice for a specific property or product requirement? Speak directly with the EFU team.</p><a class="text-link" href="/contact">Contact our team →</a></div><div>{faq.map(([q,a])=><details class="reveal"><summary>{q}</summary><p>{a}</p></details>)}</div></div></section>
  <section class="cta"><div class="container cta-inner reveal"><div><span class="eyebrow">START A CONVERSATION</span><h2>Planning a network, security or communication project?</h2><p>Share your site details or product requirements and receive a solution tailored to your operational needs.</p></div><div><a class="btn btn-white" href="/contact#quote">Request a Quote</a><a class="btn btn-outline-light" href={`https://wa.me/${company.countries.kw.whatsapp}`} target="_blank" rel="noopener noreferrer">WhatsApp EFU</a></div></div></section>
</BaseLayout>

<style>
  #solutions .service-grid{gap:1.35rem}
  #solutions .home-service-card{padding:0;min-height:0;overflow:hidden;background:#fff;border:1px solid #dce7ee;border-radius:20px;box-shadow:0 9px 28px rgba(11,31,51,.065);color:inherit;transition:opacity .6s ease,transform .3s cubic-bezier(.2,.8,.2,1),border-color .3s ease,box-shadow .3s ease;transition-delay:0s}
  #solutions .home-service-card::before{content:none}
  .home-service-media{position:relative;aspect-ratio:16/9;overflow:hidden;background:#dce8ef}
  .home-service-media::after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,rgba(5,18,29,.03),rgba(5,18,29,.12));pointer-events:none}
  .home-service-media img{width:100%;height:100%;object-fit:cover;transition:transform .3s cubic-bezier(.2,.8,.2,1)}
  .home-service-body{position:relative;display:flex;flex:1;flex-direction:column;padding:2.15rem 1.5rem 1.45rem}
  #solutions .home-service-card .icon{position:absolute;top:-23px;left:1.5rem;width:46px;height:46px;margin:0;border:4px solid #fff;border-radius:13px;background:#e6f5fb;box-shadow:0 5px 14px rgba(11,31,51,.12);transition:none}
  #solutions .home-service-card .icon :global(svg){width:20px;height:20px}
  #solutions .home-service-card .card-no{top:1.05rem;right:1.5rem;color:#8ba0ae;font-size:.65rem;letter-spacing:.08em}
  #solutions .home-service-card h3{padding-right:2.8rem;font-size:1.28rem;color:var(--navy)}
  #solutions .home-service-card p{margin:.7rem 0 1.15rem;font-size:.86rem;line-height:1.6}
  .home-service-action{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-top:auto;padding-top:.85rem;border-top:1px solid var(--line);font-size:.79rem;font-weight:800;color:var(--ink);transition:color .3s ease}
  .home-service-action>span{color:var(--orange);font-size:1rem;transition:transform .3s ease}
  #solutions .home-service-card:focus-visible{outline:3px solid var(--blue);outline-offset:3px}
  .all-solutions-link{display:flex;justify-content:center;margin-top:2rem}
  .all-solutions-link a{display:inline-flex;align-items:center;gap:.55rem;padding:.55rem .2rem;border-bottom:1px solid #b8d6e4;font:800 .84rem 'Plus Jakarta Sans',Manrope,sans-serif;color:var(--blue2);transition:color .25s ease,border-color .25s ease}
  .all-solutions-link a span{color:var(--orange);transition:transform .3s ease}
  .all-solutions-link a:hover,.all-solutions-link a:focus-visible{color:var(--navy);border-color:var(--orange)}
  .all-solutions-link a:hover span,.all-solutions-link a:focus-visible span{transform:translateX(4px)}
  .all-solutions-link a:focus-visible{outline:2px solid var(--blue2);outline-offset:5px;border-radius:2px}
  @media(hover:hover) and (pointer:fine){
    #solutions .home-service-card:hover,#solutions .home-service-card:focus-visible{transform:translateY(-6px);border-color:#9ad7eb;box-shadow:0 20px 42px rgba(11,31,51,.13)}
    #solutions .home-service-card:hover .home-service-media img,#solutions .home-service-card:focus-visible .home-service-media img{transform:scale(1.04)}
    #solutions .home-service-card:hover .home-service-action,#solutions .home-service-card:focus-visible .home-service-action{color:var(--blue2)}
    #solutions .home-service-card:hover .home-service-action>span,#solutions .home-service-card:focus-visible .home-service-action>span{transform:translateX(4px)}
  }
  @media(max-width:560px){
    #solutions .service-grid{gap:1rem}
    .home-service-body{padding:2.05rem 1.25rem 1.3rem}
    #solutions .home-service-card .icon{left:1.25rem}
    #solutions .home-service-card .card-no{right:1.25rem}
  }
  @media(prefers-reduced-motion:reduce){
    #solutions .home-service-card,.home-service-media img,.home-service-action,.home-service-action>span,.all-solutions-link a,.all-solutions-link a span{transition:none}
  }

  /* Product supply section */
  .products{padding-bottom:clamp(3rem,6vw,4.5rem)}
  .products-header{display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(2.5rem,5vw,4.5rem);align-items:center;margin-bottom:3rem}
  .products-header-copy .eyebrow{display:block;margin-bottom:.9rem}
  .products-header-copy h2{margin:0 0 1rem}
  .products-header-copy>p{max-width:46ch;margin:0 0 1.7rem;color:var(--muted);font-size:1rem;line-height:1.7}
  .products-header-actions{display:flex;align-items:center;gap:1.6rem;flex-wrap:wrap}
  .products-header-actions .text-link{display:inline-flex;align-items:center;gap:.4rem;transition:color .25s ease}
  .products-header-actions .text-link span{color:var(--orange);transition:transform .25s ease}
  .products-header-actions .text-link:hover,.products-header-actions .text-link:focus-visible{color:var(--navy)}
  .products-header-actions .text-link:hover span,.products-header-actions .text-link:focus-visible span{transform:translateX(4px)}
  .products-header-actions .text-link:focus-visible{outline:2px solid var(--blue2);outline-offset:5px;border-radius:2px}
  .products-header-media{position:relative}
  .products-header-media::before{content:'';position:absolute;top:-26px;right:-18px;width:230px;height:230px;border-radius:50%;background:radial-gradient(circle,rgba(7,157,216,.2),transparent 70%);pointer-events:none}
  .products-media-frame{position:relative;z-index:1;border-radius:22px;overflow:hidden;aspect-ratio:4/3;box-shadow:0 20px 48px rgba(11,31,51,.16)}
  .products-media-frame img{width:100%;height:100%;object-fit:cover;object-position:80% center;display:block}

  .home-product-list{display:grid;grid-template-columns:1fr 1fr;gap:.85rem 1.5rem}
  .home-product-list a{
    position:relative;display:grid;grid-template-columns:26px 40px 1fr 18px;align-items:center;gap:.8rem;
    min-height:70px;padding:.85rem 1.1rem;border-radius:13px;
    background:rgba(255,255,255,.5);border:1px solid #d7e3ea;color:inherit;
    transition:background-color .26s ease,border-color .26s ease,transform .26s ease,box-shadow .26s ease;
  }
  .home-product-list a b{font:800 .76rem 'Plus Jakarta Sans',Manrope,sans-serif;color:var(--blue2);justify-self:start}
  .home-product-icon{display:grid;place-items:center;width:36px;height:36px;border-radius:9px;background:#e9f6fb;color:var(--blue2);transition:background-color .26s ease}
  .home-product-icon :global(svg){width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
  .home-product-label{font:700 .92rem 'Plus Jakarta Sans',Manrope,sans-serif;color:var(--navy);line-height:1.3;transition:color .26s ease}
  .home-product-list a i{font-style:normal;color:var(--orange);justify-self:end;transition:transform .26s ease}
  .home-product-list a:hover,.home-product-list a:focus-visible{background:#fff;border-color:#bfe0ef;transform:translateY(-2px);box-shadow:0 14px 30px rgba(11,31,51,.1)}
  .home-product-list a:hover .home-product-icon,.home-product-list a:focus-visible .home-product-icon{background:#dcf0f9}
  .home-product-list a:hover i,.home-product-list a:focus-visible i{transform:translateX(4px)}
  .home-product-list a:hover .home-product-label,.home-product-list a:focus-visible .home-product-label{color:var(--blue2)}
  .home-product-list a:focus-visible{outline:2px solid var(--blue2);outline-offset:2px}

  @media(max-width:900px){
    .products-header{grid-template-columns:1fr}
    .products-media-frame{max-width:480px;margin:0 auto}
  }
  @media(max-width:620px){
    .home-product-list{grid-template-columns:1fr}
    .products-header-actions{flex-direction:column;align-items:flex-start;gap:1.1rem}
    .products-header-actions .btn{width:100%;min-height:46px}
  }
  @media(prefers-reduced-motion:reduce){
    .products-header-actions .text-link,.products-header-actions .text-link span,.home-product-list a,.home-product-list a i,.home-product-label,.home-product-icon{transition:none}
  }
</style>
