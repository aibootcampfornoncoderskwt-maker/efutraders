---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { products, services, company, breadcrumbList } from '../data/site';

const categories = [
  {
    title: products[0],
    description: 'Switching and routing equipment for office, commercial and infrastructure requirements.',
    image: '/images/products/network-switches-routers.webp',
    alt: 'Stacked enterprise network switches and routers with illuminated ports in a technical rack'
  },
  {
    title: products[1],
    description: 'Wireless access points and connectivity equipment for reliable business coverage.',
    image: '/images/products/wireless-access-points.webp',
    alt: 'Ceiling-mounted business wireless access point with radiating coverage rings'
  },
  {
    title: products[2],
    description: 'Branded or compatible fibre transceiver options based on equipment and network requirements.',
    image: '/images/products/sfp-transceivers.webp',
    alt: 'Fibre-optic SFP transceiver modules and a duplex patch cable with connectors'
  },
  {
    title: products[3],
    description: 'Fibre, Cat6, Cat6A, patch panels, faceplates, modules, connectors and related accessories.',
    image: '/images/products/fibre-copper-products.webp',
    alt: 'Organised patch panel with fibre and copper cables routed neatly beneath it'
  },
  {
    title: products[4],
    description: 'Floor-standing and wall-mounted network cabinets available according to project specification.',
    image: '/images/products/network-cabinets-racks.webp',
    alt: 'Floor-standing network cabinet with mounted equipment and a mesh front door'
  },
  {
    title: products[5],
    description: 'IP and wired surveillance cameras, recording equipment and related CCTV accessories.',
    image: '/images/products/cctv-cameras-recorders.webp',
    alt: 'Dome and bullet IP cameras with a network video recorder unit'
  },
  {
    title: products[6],
    description: 'Business voice equipment, IP phones and PBX hardware for communication requirements.',
    image: '/images/products/pbx-ip-phones.webp',
    alt: 'Business IP desk phone with a display and keypad beside a PBX base unit'
  },
  {
    title: products[7],
    description: 'Network, fibre, copper and communication testing tools and accessories.',
    image: '/images/products/network-testing-tools.webp',
    alt: 'Handheld network cable tester with a signal readout and a fibre test probe'
  },
  {
    title: products[8],
    description: 'Coaxial cables, connectors and communication accessories for microwave and satellite requirements.',
    image: '/images/products/microwave-satellite-products.webp',
    alt: 'Coiled coaxial cable, connectors and a satellite dish antenna'
  },
  {
    title: products[9],
    description: 'Computers, laptops, printers, scanners and supporting office technology products.',
    image: '/images/products/it-office-equipment.webp',
    alt: 'Open laptop beside an office printer'
  }
];

const relatedSolutions = services.filter(s => ['business-wifi','structured-cabling','cctv-surveillance','voip-pbx'].includes(s.slug));

const breadcrumbSchema = breadcrumbList([{ name: 'Home', url: '/' }, { name: 'Products', url: '/products' }], Astro.site);
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: categories.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.title,
    url: new URL(`/contact?product=${encodeURIComponent(c.title)}#quote`, Astro.site).toString()
  }))
};
---

<BaseLayout
  title="Networking, CCTV, PBX & IT Products"
  description="Request networking equipment, fibre and copper products, CCTV systems, PBX hardware, testing tools and IT products from EFU across Kuwait and the UAE."
  structuredData={[breadcrumbSchema, itemListSchema]}
>
  <Fragment slot="head"><link rel="preload" as="image" href="/images/hero/products-equipment.webp" imagesrcset="/images/hero/products-equipment-960.webp 960w, /images/hero/products-equipment.webp 1536w" imagesizes="(max-width: 820px) 100vw, 50vw" fetchpriority="high" /></Fragment>

  <section class="products-hero">
    <div class="container products-hero-grid">
      <div class="products-hero-copy">
        <div class="breadcrumbs">
          <a href="/">Home</a> / Products
        </div>
        <span class="eyebrow">PRODUCT SUPPLY</span>
        <h1>Technology products for complete project delivery.</h1>
        <p>Source networking, fibre, CCTV, voice and IT products—or combine product supply with professional installation, configuration and support.</p>
        <div class="products-hero-actions">
          <a class="btn" href="/contact?service=Product%20Supply#quote">Send Your Product List</a>
          <a class="btn btn-glass" href="/contact">Talk to EFU</a>
        </div>
        <div class="products-hero-points">
          <span>Multi-brand options</span>
          <span>Project-based supply</span>
          <span>Installation available</span>
        </div>
      </div>
      <div class="products-hero-media">
        <img src="/images/hero/products-equipment.webp" srcset="/images/hero/products-equipment-960.webp 960w, /images/hero/products-equipment.webp 1536w" sizes="(max-width: 820px) 100vw, 50vw" alt="Organised networking, wireless, CCTV and voice equipment arranged in a technical environment" width="1536" height="1024" loading="eager" fetchpriority="high" decoding="sync" />
      </div>
    </div>
  </section>

  <section class="section products-catalogue">
    <div class="container">
      <header class="products-catalogue-head">
        <div><span class="eyebrow">PRODUCT CATALOGUE</span><h2>Browse EFU's technology product range.</h2></div>
        <div><p>Select a category to request pricing and availability, or send a complete product list for a project quotation.</p></div>
      </header>
      <div class="product-card-grid">
        {categories.map((category, index) => <ProductCard number={String(index + 1).padStart(2, '0')} {...category} />)}
      </div>
      <p class="form-note" style="margin-top:1.75rem">Product brands and availability vary by country, specification and project requirement. Contact EFU for current options.</p>
    </div>
  </section>

  <section class="section products-related">
    <div class="container products-related-inner">
      <div><span class="eyebrow">PRODUCTS + INSTALLATION</span><h2>Prefer supply combined with installation?</h2><p>EFU can pair any product category above with professional installation, configuration and after-sales support.</p></div>
      <div class="products-related-links">
        {relatedSolutions.map(s => <a class="text-link" href={`/solutions/${s.slug}`}>{s.title} →</a>)}
      </div>
    </div>
  </section>

  <section class="section products-boq">
    <div class="container products-boq-inner">
      <div>
        <span class="eyebrow">HAVE A PRODUCT LIST OR BOQ?</span>
        <h2>Send your requirements for a project quotation.</h2>
        <p>Share the required products, preferred brands, specifications, quantities and destination. EFU will review the available supply options for your project.</p>
        <p class="form-note">Attachment upload is not yet available on the quotation form. Please describe your product list or BOQ in the enquiry details, or send the file directly over WhatsApp.</p>
      </div>
      <div class="products-boq-actions">
        <a class="btn btn-white" href="/contact?service=Product%20Supply#quote">Send Your Product List</a>
        <a class="btn btn-outline" href={`https://wa.me/${company.countries.kw.whatsapp}?text=${encodeURIComponent('Hello EFU, I would like to send a product list / BOQ for a project quotation.')}`} target="_blank" rel="noopener noreferrer">WhatsApp EFU</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .products-hero{background:var(--navy);color:#fff;overflow:hidden;padding:3.5rem 0}
  .products-hero-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);align-items:center;gap:4vw}
  .products-hero-copy{min-width:0}
  .products-hero-copy .breadcrumbs{color:#89a3b5;margin-bottom:1.6rem}
  .products-hero-copy .eyebrow{color:#7dd2ec}
  .products-hero-copy h1{color:#fff;font-size:clamp(2.3rem,3.6vw,3.5rem);line-height:1.05;max-width:600px}
  .products-hero-copy>p{color:#c8d7e2;font-size:1.05rem;max-width:520px;margin-top:1.3rem}
  .products-hero-actions{display:flex;gap:.8rem;margin-top:2rem;flex-wrap:wrap;min-width:0}
  .products-hero-actions .btn{min-width:0}
  .btn-glass{background:rgba(255,255,255,.08);border-color:rgba(255,255,255,.3);color:#fff;backdrop-filter:blur(10px)}
  .products-hero-points{display:flex;flex-wrap:wrap;gap:.6rem 1.4rem;margin-top:1.6rem;color:#dce9f1;font-size:.78rem;font-weight:700;min-width:0}
  .products-hero-points span::before{content:'✓';margin-right:.42rem;color:var(--blue)}
  .products-hero-media{position:relative;border-radius:22px;overflow:hidden;box-shadow:0 30px 70px rgba(0,0,0,.4);aspect-ratio:3/2;min-width:0}
  .products-hero-media img{width:100%;height:100%;object-fit:cover}
  @media(max-width:980px){
    .products-hero-grid{grid-template-columns:minmax(0,1fr);gap:2.2rem}
    .products-hero-copy h1{max-width:none}
    .products-hero-media{order:-1}
  }
  @media(max-width:560px){
    .products-hero{padding:2.5rem 0}
    .products-hero-actions{display:grid}
    .products-hero-actions .btn{min-height:45px}
  }

  .products-catalogue{background:linear-gradient(180deg,#f8fbfd 0%,#fff 42%)}
  .products-catalogue-head{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(280px,.75fr);align-items:end;gap:6vw;margin-bottom:3rem}
  .products-catalogue-head h2{max-width:640px}
  .products-catalogue-head p{max-width:440px;font-size:.95rem}
  .product-card-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));align-items:stretch;gap:1.25rem}
  .product-card-grid>:global(.product-card){grid-column:span 2}
  .product-card-grid>:global(.product-card:nth-last-child(-n+2)){grid-column:span 3}
  @media(max-width:980px){
    .products-catalogue-head{grid-template-columns:1fr;gap:1.25rem}
    .product-card-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
    .product-card-grid>:global(.product-card),.product-card-grid>:global(.product-card:nth-last-child(-n+2)){grid-column:span 1}
  }
  @media(max-width:600px){
    .products-catalogue-head{margin-bottom:2rem}
    .product-card-grid{grid-template-columns:1fr;gap:1rem}
  }

  .products-related-inner{display:grid;grid-template-columns:1fr 1fr;gap:4vw;align-items:center;padding:2.75rem;background:var(--bg);border-radius:20px}
  .products-related-inner p{margin-top:.8rem;max-width:460px}
  .products-related-links{display:flex;flex-wrap:wrap;gap:.6rem 1.6rem}
  @media(max-width:820px){.products-related-inner{grid-template-columns:1fr;gap:1.4rem;padding:2rem}}

  .products-boq{padding:5.5rem 0}
  .products-boq-inner{display:flex;justify-content:space-between;align-items:center;gap:5vw;padding:3.5rem;border-radius:22px;background:linear-gradient(115deg,var(--blue2),#075884);color:#fff}
  .products-boq-inner h2{color:#fff;max-width:560px}
  .products-boq-inner>div:first-child p{color:#d7edf5;margin-top:1.1rem;max-width:520px}
  .products-boq-inner .form-note{color:#bfe0ee;margin-top:1rem;max-width:480px}
  .products-boq-actions{display:flex;flex-direction:column;gap:.7rem;white-space:nowrap}
  .btn-outline{background:transparent;border-color:rgba(255,255,255,.55);color:#fff}
  @media(max-width:980px){
    .products-boq-inner{flex-direction:column;align-items:flex-start;padding:2.5rem}
    .products-boq-actions{width:100%}
    .products-boq-actions .btn{width:100%}
  }
</style>
