---
import BaseLayout from '../layouts/BaseLayout.astro'; import { products } from '../data/site';
---
<BaseLayout title="Technology Products" description="Networking equipment, fibre, copper, CCTV, PBX, racks, testing tools and IT products supplied by EFU."><section class="page-hero"><div class="container"><div class="breadcrumbs"><a href="/">Home</a> / Products</div><span class="eyebrow">PRODUCT SUPPLY</span><h1>Technology products for complete project delivery.</h1><p>Request individual products or combine equipment supply with installation, configuration and support.</p></div></section><section class="section products"><div class="container"><div class="product-list">{products.map((p,i)=><a href={`/contact?product=${encodeURIComponent(p)}#quote`}><b>{String(i+1).padStart(2,'0')}</b><span>{p}</span><i>Request quote →</i></a>)}</div><p class="form-note" style="margin-top:2rem">Product brands and availability vary by country and project requirement. Contact EFU for current options.</p></div></section></BaseLayout>
