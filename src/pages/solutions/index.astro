---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Icon from '../../components/Icon.astro'; import { services } from '../../data/site';
---
<BaseLayout title="Technology Solutions" description="Business Wi-Fi, structured cabling, CCTV, PBX, network security and installation solutions across Kuwait and the UAE."><section class="page-hero"><div class="container"><div class="breadcrumbs"><a href="/">Home</a> / Solutions</div><span class="eyebrow">TECHNOLOGY & INFRASTRUCTURE</span><h1>Complete solutions from survey to support.</h1><p>EFU brings planning, supply, installation and technical assistance together for reliable infrastructure across commercial and residential environments.</p></div></section><section class="section"><div class="container service-grid">{services.map((s,i)=><article class="service-card visible"><div class="icon"><Icon name={s.icon}/></div><span class="card-no">0{i+1}</span><h2 style="font-size:1.35rem">{s.title}</h2><p>{s.short}</p><a href={`/solutions/${s.slug}`}>Explore solution <span>→</span></a></article>)}</div></section></BaseLayout>
