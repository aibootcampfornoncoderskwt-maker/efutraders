---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { services } from '../../data/site';
export function getStaticPaths(){return services.map(service=>({params:{slug:service.slug},props:{service}}))}
const { service }=Astro.props;
---
<BaseLayout title={`${service.title} Solutions`} description={`${service.short} EFU serves projects across Kuwait and the UAE.`}><section class="page-hero"><div class="container"><div class="breadcrumbs"><a href="/">Home</a> / <a href="/solutions">Solutions</a> / {service.title}</div><span class="eyebrow">EFU TECHNOLOGY SOLUTIONS</span><h1>{service.title} for reliable operations.</h1><p>{service.short}</p><div class="hero-actions" style="margin-top:2rem"><a class="btn" href="/contact#quote">Request a Site Survey</a><a class="btn btn-outline-light" href="/contact">Talk to EFU</a></div></div></section><section class="section"><div class="container content-grid"><article class="prose"><span class="eyebrow">SERVICE OVERVIEW</span><h2>A solution designed around your site.</h2><p>Every property has different coverage, connectivity and operational requirements. EFU begins by understanding the existing environment and the expected outcome before recommending products or an installation approach.</p><ul class="feature-list">{service.features.map((x:string)=><li>{x}</li>)}<li>Project supply</li><li>Configuration and handover</li><li>Maintenance options</li></ul><h2>Our delivery approach</h2><p>The typical process covers requirement review, site assessment where appropriate, solution planning, equipment selection, installation, configuration, testing and final handover. The exact scope is confirmed in the project quotation.</p><h2>Suitable environments</h2><p>EFU supports offices, villas, retail locations, restaurants, warehouses, educational facilities and other commercial environments across Kuwait and the UAE.</p></article><aside class="side-card"><span class="eyebrow">START YOUR PROJECT</span><h3>Need {service.title.toLowerCase()}?</h3><p>Share your property type, location and requirements with the EFU team.</p><a class="btn" href={`/contact?service=${service.slug}#quote`}>Request a Quote</a></aside></div></section></BaseLayout>
