---
import BaseLayout from '../layouts/BaseLayout.astro'; import { company, services } from '../data/site';
---
<BaseLayout title="Contact & Request a Quote" description="Contact EFU Goods Traders for networking, cabling, CCTV, PBX, products, installation and trading enquiries."><section class="page-hero"><div class="container"><div class="breadcrumbs"><a href="/">Home</a> / Contact</div><span class="eyebrow">CONTACT EFU</span><h1>Tell us what your project needs.</h1><p>Share your location, property type and requirements. The appropriate EFU team can then discuss the next step and prepare a quotation.</p></div></section><section class="section" id="quote"><div class="container content-grid"><div><span class="eyebrow">REQUEST A QUOTE</span><h2 style="margin-bottom:2rem">Project enquiry</h2><form class="quote-form" id="quote-form"><label style="display:none">Leave this empty<input name="website" tabindex="-1" autocomplete="off"/></label><label>Full name *<input name="name" autocomplete="name" required/></label><label>Company<input name="company" autocomplete="organization"/></label><label>Phone / WhatsApp *<input name="phone" autocomplete="tel" required/></label><label>Email *<input name="email" type="email" autocomplete="email" required/></label><label>Country *<select name="country" required><option value="">Select country</option><option>Kuwait</option><option>United Arab Emirates</option><option>India</option></select></label><label>Required service *<select name="service" required><option value="">Select service</option>{services.map(s=><option>{s.title}</option>)}<option>Product Supply</option><option>Trading & Supply</option><option>Other</option></select></label><label class="full">Project details *<textarea name="message" maxlength="5000" required placeholder="Property type, area, current issue, required products or expected project scope"></textarea></label><label class="full" style="display:flex;grid-template-columns:auto 1fr;align-items:start"><input type="checkbox" required style="width:auto;margin-top:.3rem"/>I agree that EFU may contact me regarding this enquiry.</label><button class="btn full" type="submit">Send Enquiry</button><p class="form-note full" id="form-status" role="status">Do not include passwords, private access credentials or other sensitive information.</p></form></div><aside class="side-card"><span class="eyebrow">DIRECT CONTACT</span><h3>Kuwait</h3><p>{company.countries.kw.phone}</p><a class="text-link" href={`https://wa.me/${company.countries.kw.whatsapp}`} target="_blank">WhatsApp Kuwait →</a><h3 style="margin-top:2rem">UAE</h3><p><a href={`tel:${company.countries.ae.tel}`}>{company.countries.ae.phone}</a></p><a class="text-link" href={`https://wa.me/${company.countries.ae.whatsapp}`} target="_blank">WhatsApp UAE →</a><h3 style="margin-top:2rem">India</h3><p>{company.countries.in.phone}</p><h3 style="margin-top:2rem">Email</h3><a class="text-link" href={`mailto:${company.email}`}>{company.email}</a></aside></div></section><script>const form=document.querySelector<HTMLFormElement>('#quote-form');form?.addEventListener('submit',async(e)=>{e.preventDefault();const button=form.querySelector<HTMLButtonElement>('button')!;const status=document.querySelector<HTMLElement>('#form-status')!;button.disabled=true;button.textContent='Sending…';status.textContent='Sending your enquiry…';try{const data=Object.fromEntries(new FormData(form).entries());const response=await fetch('/api/quote',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});const result=await response.json();if(!response.ok)throw new Error(result.error||'Unable to send enquiry.');location.href='/thank-you'}catch(error){status.textContent=error instanceof Error?error.message:'Unable to send enquiry. Please contact EFU directly.';button.disabled=false;button.textContent='Send Enquiry'}});</script></BaseLayout>
